APP_ENV=development

# Database - PostgreSQL or SQLite fallback
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dealmind
# Fallback to SQLite if Postgres unavailable: sqlite:///./dealmind.db

# LLM Configuration (Groq recommended)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
LLM_MODEL=llama-3.3-70b-versatile

# Hindsight Memory Service (Vectorize)
# Local Docker: http://localhost:8888
# Cloud: https://api.hindsight.vectorize.io
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=dealmind-demo

# CORS for local dev
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PORT=8000