APP_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dealmind
# Fallback to SQLite if postgres unavailable: sqlite:///./dealmind.db

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Groq-valid models for this key: openai/gpt-oss-20b, openai/gpt-oss-120b, allam-2-7b, qwen/qwen3-8b

# Hindsight: local Docker vs Cloud
HINDSIGHT_API_URL=http://localhost:8888
# Local Docker (free, no credits): keep above as http://localhost:8888, leave HINDSIGHT_API_KEY empty
# Cloud (managed): https://api.hindsight.vectorize.io + HINDSIGHT_API_KEY=hsk_...
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=dealmind-demo
# Required by hindsight Docker image (ghcr.io/vectorize-io/hindsight:latest):
HINDSIGHT_API_LLM_PROVIDER=groq
HINDSIGHT_API_LLM_API_KEY=${LLM_API_KEY}

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PORT=8000
